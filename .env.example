# ============================================================
# 复制这个文件为 .env，然后填入你自己的 API Key
#   Windows:  copy .env.example .env
# ============================================================

# 必填：API Key
API_KEY=在这里填入你的key

# 可选：模型名称，默认 deepseek-chat
MODEL=deepseek-chat

# 可选：本地服务端口，默认 3000
PORT=3000
